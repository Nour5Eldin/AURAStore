PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/fashion-store

# Auth0
AUTH0_DOMAIN=noureldin65.us.auth0.com
AUTH0_AUDIENCE=https://fashion-store-api

# Admin access — set this to the ONE email that should get the ADMIN role.
# Everyone else who logs in via Auth0 is assigned the USER role.
ADMIN_EMAIL=admin@your-domain.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
DEFAULT_AVATAR_URL=https://res.cloudinary.com/...

# Store Config
STORE_NAME=Fashion Store
STORE_EMAIL=store@example.com
