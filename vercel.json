{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "fashion-store-backend": {
      "root": "fashion-store-backend",
      "framework": "express",
      "entrypoint": "src/app.ts"
    },
    "fashion-store-frontend": {
      "root": "fashion-store-frontend",
      "framework": "angular"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "fashion-store-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "fashion-store-frontend"
      }
    }
  ]
}
